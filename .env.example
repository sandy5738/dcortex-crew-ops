# Copy to .env and fill in.  .env is git-ignored (.gitignore: .env.*  / .env).
# Never paste a key into a terminal you are screen-sharing.

# Sarvam AI — https://dashboard.sarvam.ai
# Sent as the `api-subscription-key` header.
SARVAM_API_KEY=

# sarvam-105b-conversations — fast, answers directly. NOT sarvam-105b: it is a
# sarvam-m is DEPRECATED and no longer served by chat completions.
SARVAM_MODEL=sarvam-105b-conversations

# 0 = as reproducible as the API allows. Sarvam exposes no seed parameter, so
# the parse step is the only part of the pipeline that is not bit-reproducible.
# Everything after it is pure TypeScript. Do not raise this.
SARVAM_TEMPERATURE=0

# false => the deterministic keyword parser and template narrator. Every
# question still answers; only the phrasing tolerance narrows. This is the
# demo safety switch — test it before presenting.
CREWOPS_LLM_ENABLED=true

PORT=3000
